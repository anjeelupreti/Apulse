# Copy to backend/.env for local development. Never commit real values.
# Every variable is documented in docs/CONVENTIONS.md and read in config/settings/base.py.

# --- core
BACKEND_ENVIRONMENT=local                 # local | test | staging | production
BACKEND_SECRET_KEY=change-me-local-only
BACKEND_DEBUG=true
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
BACKEND_APP_VERSION=0.1.0-dev
BACKEND_GIT_SHA=
BACKEND_BUILD_TIME=
BACKEND_ADMIN_ENABLED=true

# --- data stores (match deployment/compose/docker-compose.dev.yml)
BACKEND_DATABASE_URL=postgres://npms_app:npms_app@localhost:55432/npms
BACKEND_DB_CONN_MAX_AGE=60
BACKEND_REDIS_URL=redis://localhost:56379/0
BACKEND_CELERY_BROKER_URL=redis://localhost:56379/1

# --- object storage (MinIO locally)
BACKEND_USE_S3=false
BACKEND_S3_ENDPOINT_URL=http://localhost:59000
BACKEND_S3_ACCESS_KEY_ID=npms
BACKEND_S3_SECRET_ACCESS_KEY=npms-minio-secret
BACKEND_S3_REGION=us-east-1
BACKEND_S3_BUCKET_ATTACHMENTS=npms-attachments

# --- email (Mailpit locally: UI at http://localhost:51026)
BACKEND_EMAIL_URL=smtp://localhost:51025
BACKEND_DEFAULT_FROM_EMAIL=NPMS <no-reply@localhost>

# --- tenancy (tenants are reached at {slug}.{base domain}, e.g. demo.localhost:8000)
BACKEND_TENANT_BASE_DOMAIN=localhost
# Leave false until tokens carry a verified tenant claim (M2.2): a header alone is not proof.
BACKEND_TENANT_ALLOW_HEADER_RESOLUTION=false

# --- web
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
BACKEND_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
BACKEND_THROTTLE_ANON=60/min
BACKEND_THROTTLE_USER=600/min

# --- observability
BACKEND_LOG_JSON=false
BACKEND_LOG_LEVEL=INFO
BACKEND_SENTRY_DSN=
BACKEND_SENTRY_TRACES_SAMPLE_RATE=0.0
